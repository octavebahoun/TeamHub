# Bloc à ajouter dans le Caddyfile existant du serveur
# (ex: ~/EPINET/infra/caddy/Caddyfile) puis recharger Caddy :
#   docker exec epitnet-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#
# Prérequis: les conteneurs TeamHub sont lancés et bindent sur
#   127.0.0.1:8100 (api), 127.0.0.1:4100 (realtime), 127.0.0.1:3100 (web).

teamhub.excellenceteam.site {
	import secure_headers
	encode gzip zstd

	# Bloquer les routes internes — jamais exposées depuis Internet
	@internal path /api/internal/* /api/v1/internal/*
	handle @internal {
		respond "Not Found" 404
	}

	# API Laravel
	handle /api/* {
		reverse_proxy host.docker.internal:8100
	}

	# WebSocket temps réel
	handle /ws/* {
		reverse_proxy host.docker.internal:4100
	}
	handle /socket.io/* {
		reverse_proxy host.docker.internal:4100
	}

	# Frontend Next.js — tout le reste
	handle {
		reverse_proxy host.docker.internal:3100
	}
}
