# ---------------------------------------------------------------------------
# TeamHub — variables d'environnement racine (dev + prod)
# Copier en .env avant de lancer docker compose.
# ---------------------------------------------------------------------------

# Domaine unique servi par Caddy (HTTPS auto). Pour dev local: localhost.
DOMAIN=teamhub.excellenceteam.site

# APP_KEY Laravel — générer avec:
#   docker compose run --rm api php artisan key:generate --show
# puis coller ici (format base64:xxx…).
APP_KEY=

# Secret partagé entre api ↔ realtime ↔ data (jamais exposé au navigateur).
# Générer avec: openssl rand -hex 32
INTERNAL_SECRET=

# Secret HMAC-SHA256 du compte Contravo (sandbox puis prod), pour vérifier
# ses webhooks entrants (quote.accepted, invoice.paid...). Fourni par Hubert.
CONTRAVO_WEBHOOK_SECRET=

# E-mails internes WINE (invitation, mot de passe, rappel de tâche).
# Les e-mails clients (devis, factures, relances) restent dans Contravo.
# Tant que les clés ne sont pas là : MAIL_MAILER=log (le lien est écrit dans les logs Laravel).
# Brevo : MAIL_MAILER=smtp MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
# Resend : MAIL_MAILER=smtp MAIL_HOST=smtp.resend.com MAIL_PORT=587 MAIL_USERNAME=resend
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=WINE

# Postgres embarqué (retirer + définir DATABASE_URL pour passer en managé RDS).
POSTGRES_DB=teamhub
POSTGRES_USER=teamhub
POSTGRES_PASSWORD=

# URLs modulaires — laisser vide pour utiliser les services Docker embarqués.
# Passer en managé = renseigner ces URL et retirer le service correspondant.
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_URL_DATA=postgresql+psycopg://user:pass@host:5432/db
# MONGO_URL=mongodb://user:pass@host:27017/db
# REDIS_URL=redis://:pass@host:6379

# Service data — bilan hebdomadaire et relances (repli déterministe si vide).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Sauvegardes (infra/backup.sh) — optionnel, compatible Cloudflare R2.
# BACKUP_DIR=/var/backups/teamhub
# BACKUP_KEEP_DAYS=7
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=teamhub-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
