# ---------------------------------------------------------------------------
# TeamHub — variables d'environnement racine (dev + prod)
# Copier en .env avant de lancer docker compose.
# ---------------------------------------------------------------------------

# Domaine unique servi par Caddy (HTTPS auto). Pour dev local: localhost.
DOMAIN=teamhub.excellenceteam.site

# APP_KEY Laravel — générer avec:
#   docker compose run --rm api php artisan key:generate --show
# puis coller ici (format base64:xxx…).
APP_KEY=

# Secret partagé entre api ↔ realtime ↔ data (jamais exposé au navigateur).
# Générer avec: openssl rand -hex 32
INTERNAL_SECRET=

# Postgres embarqué (retirer + définir DATABASE_URL pour passer en managé RDS).
POSTGRES_DB=teamhub
POSTGRES_USER=teamhub
POSTGRES_PASSWORD=

# URLs modulaires — laisser vide pour utiliser les services Docker embarqués.
# Passer en managé = renseigner ces URL et retirer le service correspondant.
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_URL_DATA=postgresql+psycopg://user:pass@host:5432/db
# MONGO_URL=mongodb://user:pass@host:27017/db
# REDIS_URL=redis://:pass@host:6379
